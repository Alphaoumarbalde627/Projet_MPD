{% extends 'base.html.twig' %}

{% block title %}À propos de nous - MPD et Frères{% endblock %}

{% block body %}
    {% include 'partials/headers.html.twig' %}

    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-blue-900 to-blue-800 text-white">
        <div class="container mx-auto px-6 py-20 lg:py-28">
            <div class="max-w-4xl mx-auto text-center">
                <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">À propos de nous</h1>
                <p class="text-xl text-blue-100">MPD et Frères : Une entreprise guinéenne au service du développement local depuis 2005</p>
            </div>
        </div>
    </section>

    <!-- À propos / Who are we -->
    <section class="bg-white">
        <div class="container mx-auto px-6 py-20">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold text-blue-900 mb-6">Qui sommes-nous ?</h2>
                <div class="prose prose-lg max-w-none text-gray-700 space-y-4">
                    <p>MPD et Frères est une société à responsabilité limitée de droit guinéen, créée par des Guinéens pour la Guinée et les Guinéens. Fondée en 2005, l'entreprise s'inscrit dans une dynamique de développement local et de contribution active à l'économie nationale.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Domaines d'activité -->
    <section class="bg-blue-50">
        <div class="container mx-auto px-6 py-20">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold text-blue-900 mb-8">Nos domaines d'activité</h2>
                <p class="text-gray-700 mb-8">MPD et Frères intervient dans plusieurs secteurs clés :</p>
                
                <div class="grid gap-6 md:grid-cols-2">
                    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                        <h3 class="font-semibold text-blue-900 mb-2 flex items-center gap-2">
                            <span class="w-2 h-2 bg-blue-700 rounded-full"></span>
                            Fourniture de mobilier de bureau
                        </h3>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                        <h3 class="font-semibold text-blue-900 mb-2 flex items-center gap-2">
                            <span class="w-2 h-2 bg-blue-700 rounded-full"></span>
                            Fourniture de matériel informatique
                        </h3>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                        <h3 class="font-semibold text-blue-900 mb-2 flex items-center gap-2">
                            <span class="w-2 h-2 bg-blue-700 rounded-full"></span>
                            Fourniture d'équipements électroménagers
                        </h3>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                        <h3 class="font-semibold text-blue-900 mb-2 flex items-center gap-2">
                            <span class="w-2 h-2 bg-blue-700 rounded-full"></span>
                            Fourniture de meubles
                        </h3>
                    </div>
                    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-700">
                        <h3 class="font-semibold text-blue-900 mb-2 flex items-center gap-2">
                            <span class="w-2 h-2 bg-blue-700 rounded-full"></span>
                            Divers
                        </h3>
                    </div>
                </div>
                
                <p class="text-gray-700 mt-8">Grâce à cette diversité, nous accompagnons nos clients avec des solutions adaptées à leurs besoins spécifiques.</p>
            </div>
        </div>
    </section>

    <!-- Notre engagement -->
    <section class="bg-white">
        <div class="container mx-auto px-6 py-20">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold text-blue-900 mb-8">Notre engagement</h2>
                <p class="text-gray-700 mb-8">En tant que société de droit privé au service de la Guinée, nous nous engageons chaque jour à offrir à nos clients :</p>
                
                <ul class="space-y-4 mb-8">
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-blue-700 text-white font-bold">✓</span>
                        <span class="text-gray-700"><strong>Un service de qualité</strong></span>
                    </li>
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-blue-700 text-white font-bold">✓</span>
                        <span class="text-gray-700"><strong>Le respect strict des exigences</strong></span>
                    </li>
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-blue-700 text-white font-bold">✓</span>
                        <span class="text-gray-700"><strong>Le respect des délais</strong></span>
                    </li>
                    <li class="flex gap-4">
                        <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-blue-700 text-white font-bold">✓</span>
                        <span class="text-gray-700"><strong>Une rigueur professionnelle exemplaire</strong></span>
                    </li>
                </ul>
                
                <p class="text-gray-700 bg-blue-50 p-6 rounded-lg border-l-4 border-blue-700">Notre priorité est la satisfaction de nos clients à travers des prestations fiables et durables.</p>
            </div>
        </div>
    </section>

    <!-- Notre expérience et Vision -->
    <section class="bg-blue-50">
        <div class="container mx-auto px-6 py-20">
            <div class="grid gap-12 lg:grid-cols-2">
                <div class="bg-white p-8 rounded-lg shadow-lg">
                    <h2 class="text-3xl font-bold text-blue-900 mb-6">Notre expérience</h2>
                    <p class="text-gray-700 leading-relaxed">Depuis sa création, MPD et Frères a su bâtir une solide réputation en collaborant avec une large variété de clients, tant privés que publics. Nous avons déjà réalisé plusieurs projets d'envergure, témoignant de notre savoir-faire et de notre professionnalisme.</p>
                </div>
                <div class="bg-white p-8 rounded-lg shadow-lg">
                    <h2 class="text-3xl font-bold text-blue-900 mb-6">Notre vision</h2>
                    <p class="text-gray-700 leading-relaxed">Nous ambitionnons de faire de MPD et Frères une entreprise de référence à l'échelle internationale dans nos domaines d'expertise. Nous croyons fermement qu'une entreprise durable repose sur des partenariats solides.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-r from-blue-900 to-blue-800 text-white">
        <div class="container mx-auto px-6 py-16 text-center">
            <h3 class="text-3xl font-bold mb-4">Parlez-nous de vos projets</h3>
            <p class="text-blue-100 mb-8 text-lg">Découvrez comment MPD et Frères peut vous accompagner dans vos besoins en mobilier, équipements informatiques et électroménagers.</p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a href="{{ path('app_produit_index') }}" class="inline-flex items-center justify-center rounded-lg bg-white text-blue-900 px-8 py-3 font-semibold shadow-lg hover:bg-blue-50 transition">Explorer nos produits</a>
                <a href="#" class="inline-flex items-center justify-center rounded-lg bg-blue-600 text-white px-8 py-3 font-semibold hover:bg-blue-700 transition">Nous contacter</a>
            </div>
        </div>
    </section>
<!-- Footer -->
{% include 'partials/footer.html.twig' %}
{% endblock %}
