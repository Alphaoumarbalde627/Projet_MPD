<!-- Main Header -->
<header class="bg-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-6">
        <div class="flex items-center justify-between py-4">
            <!-- Logo -->
            <a href="/" class="flex items-center">
                <div class="w-48 h-20 bg-white flex items-center justify-center">
                    <img src="/images/Logo.png" alt="Galerie MPD Logo" class="h-full object-contain">
                </div>
            </a>

            <!-- Search Bar (Desktop) -->
            <div class="hidden lg:flex flex-1 max-w-xl mx-8">
                <form action="{{ path('app_produit_index') }}" method="get" class="relative w-full">
                    <input
                        type="text"
                        name="q"
                        value="{{ app.request.query.get('q') }}"
                        placeholder="Rechercher des produits..."
                        class="w-full px-4 py-3 pl-12 pr-12 border-2 border-gray-200 rounded-full focus:outline-none focus:border-blue-500 transition-colors"
                    >
                    <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 px-3 py-1.5 text-xs font-semibold text-white bg-blue-700 hover:bg-blue-800 rounded-full transition-colors">
                        Rechercher
                    </button>
                </form>
            </div>

            <!-- Right Actions -->
            <div class="flex items-center gap-3">
                <!-- Compte / Connexion / Déconnexion -->
                {% if app.user %}
                    <span class="hidden md:flex items-center gap-2 px-3 py-2 text-blue-900 text-sm font-medium">
                        {{ app.user.prenom ?? app.user.userIdentifier }}
                    </span>
                    <a href="{{ path('_logout_main') }}" class="hidden md:flex items-center gap-2 px-4 py-2 text-red-600 hover:text-red-700 hover:bg-red-50 rounded-lg transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                        <span class="text-sm font-medium">Déconnexion</span>
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="hidden md:flex items-center gap-2 px-4 py-2 text-blue-900 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        <span class="text-sm font-medium">Se connecter</span>
                    </a>
                {% endif %}
                
                <!-- Cart -->
                <a href="{{ path('app_cart_index') }}" class="relative flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg hover:from-blue-700 hover:to-blue-800 shadow-md hover:shadow-lg transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <span class="text-sm font-medium">Panier</span>
                    <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">{{ cart_count() }}</span>
                </a>

                <!-- Mobile Menu Button -->
                <button class="lg:hidden p-2 text-blue-900 hover:bg-blue-50 rounded-lg">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="hidden lg:flex items-center justify-center border-t border-gray-100 py-3">
            {% set nav_data = client_navigation_data() %}
            <div class="flex items-center gap-1">
                <!-- Accueil -->
                <a href="{{ path('app_home') }}" class="flex items-center gap-1 px-4 py-2 text-blue-900 font-medium hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-all">
                    <span>Accueil</span>
                </a>

                <!-- Produits -->
                <a href="{{ path('app_produit_index') }}" class="flex items-center gap-1 px-4 py-2 text-blue-900 font-medium hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0l-2.293 2.293a1 1 0 00-.293.707V19a2 2 0 01-2 2H8a2 2 0 01-2-2v-2.999a1 1 0 00-.293-.707L3 13m17 0H3"/>
                    </svg>
                    <span>Produits</span>
                </a>

                {% for category in nav_data.categories %}
                    <div class="relative group">
                        <a href="{{ path('app_produit_index', {category: category.id}) }}" class="flex items-center gap-1 px-4 py-2 text-blue-900 font-medium hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-all">
                            <span>{{ category.nom }}</span>
                            {% if category.sousCategories is not empty %}
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            {% endif %}
                        </a>

                        {% if category.sousCategories is not empty %}
                            <div class="absolute left-0 top-full mt-2 w-56 bg-white rounded-xl shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2 max-h-96 overflow-y-auto">
                                {% for sousCategorie in category.sousCategories %}
                                    <a href="{{ path('app_produit_index', {category: category.id, sous_categorie: sousCategorie.id}) }}" class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                                        <span class="text-xs">•</span>
                                        <span>{{ sousCategorie.nom }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}

                {% if nav_data.services is not empty %}
                    <div class="relative group">
                        <a href="{{ path('app_home') }}#services" class="flex items-center gap-1 px-4 py-2 text-blue-900 font-medium hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-all">
                            <span>Services</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </a>
                        <div class="absolute left-0 top-full mt-2 w-64 bg-white rounded-xl shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2 max-h-96 overflow-y-auto">
                            {% for service in nav_data.services %}
                                <a href="{{ path('app_home') }}#services" class="flex items-center gap-3 px-4 py-2.5 text-gray-700 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                                    <span class="text-xs">•</span>
                                    <span>{{ service.nom }}</span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- À propos -->
                <a href="{{ path('app_about') }}" class="flex items-center gap-1 px-4 py-2 text-blue-900 font-medium hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-all">
                    <span>À propos</span>
                </a>

                <!-- Témoignages -->
                <a href="{{ path('app_home') }}#temoignages" class="flex items-center gap-1 px-4 py-2 text-blue-900 font-medium hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-all">
                    <span>Témoignages</span>
                </a>
            </div>
        </nav>
    </div>
</header>
