{% extends 'base.html.twig' %}

{% block title %}Gestion des Produits{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    {% include 'admin/partials/sidebar.html.twig' with { admin_sidebar_active: 'produits' } %}

    <div class="mx-auto max-w-7xl px-5 py-8 lg:pl-80 lg:pr-8 lg:py-10">
        <main>
            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-lg px-4 py-3 text-sm font-medium
                        {% if label == 'success' %}bg-green-50 border border-green-200 text-green-800
                        {% else %}bg-red-50 border border-red-200 text-red-800{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {# En-tête #}
            <div class="mb-6 flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight text-blue-900">Produits</h2>
                    <p class="mt-1 text-sm text-slate-500">{{ total_produits }} produit(s) au total</p>
                </div>
                <a href="{{ path('app_admin_produit_new') }}"
                   class="inline-flex items-center gap-2 rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-800">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Nouveau produit
                </a>
            </div>

            <div class="mb-5">
                <form method="get" class="flex flex-wrap items-center gap-3">
                    <div class="flex items-center gap-2 rounded-xl border border-blue-100 bg-white px-4 py-2.5 shadow-sm transition focus-within:border-blue-400 focus-within:ring-2 focus-within:ring-blue-100">
                        <svg class="h-4 w-4 flex-shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"/>
                        </svg>
                        <select id="sous_categorie" name="sous_categorie"
                                onchange="this.form.submit()"
                                class="min-w-[200px] border-0 bg-transparent text-sm font-medium text-slate-700 focus:outline-none focus:ring-0">
                            <option value="">Toutes les sous-catégories</option>
                            {% for sousCategorie in sous_categories %}
                                <option value="{{ sousCategorie.id }}" {% if selected_sous_categorie_id == sousCategorie.id %}selected{% endif %}>{{ sousCategorie.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {% if selected_sous_categorie_id %}
                        <a href="{{ path('app_admin_produit_index') }}"
                           class="inline-flex items-center gap-1.5 rounded-xl border border-blue-200 bg-blue-50 px-3 py-2.5 text-sm font-medium text-blue-700 transition hover:bg-blue-100">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                            Effacer le filtre
                        </a>
                    {% endif %}
                </form>
            </div>

            {# Tableau des produits #}
            <div class="overflow-hidden rounded-xl border border-blue-100 bg-white shadow-sm">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-blue-100">
                        <thead class="bg-gradient-to-r from-blue-50 to-white">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Image</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Nom</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Prix</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Stock</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Sous-catégorie</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Statut</th>
                                <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-blue-50">
                            {% for produit in produits %}
                                <tr class="transition hover:bg-blue-50/40">
                                    <td class="px-4 py-3">
                                        {% if produit.image %}
                                            <img src="{{ asset(produit.image) }}" alt="{{ produit.nom }}"
                                                 class="h-12 w-12 rounded-lg object-cover shadow-sm">
                                        {% else %}
                                            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100 text-blue-400">
                                                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                                </svg>
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3">
                                        <p class="font-semibold text-slate-800">{{ produit.nom }}</p>
                                        <p class="text-xs text-slate-400">{{ produit.reference }}</p>
                                    </td>
                                    <td class="px-4 py-3 text-sm font-medium text-slate-700">
                                        {{ produit.prix|number_format(0, ',', ' ') }} GNF
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
                                            {% if produit.quantiteStock > 10 %}bg-green-100 text-green-700
                                            {% elseif produit.quantiteStock > 0 %}bg-yellow-100 text-yellow-700
                                            {% else %}bg-red-100 text-red-700{% endif %}">
                                            {{ produit.quantiteStock }}
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-slate-600">
                                        {{ produit.sousCategorie ? produit.sousCategorie.nom : '—' }}
                                    </td>
                                    <td class="px-4 py-3">
                                        {% if produit.estActif %}
                                            <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700">Actif</span>
                                        {% else %}
                                            <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-500">Inactif</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="flex items-center justify-center gap-2">
                                            <a href="{{ path('app_admin_produit_show', {id: produit.id}) }}"
                                               title="Voir"
                                               class="inline-flex items-center rounded-md bg-blue-50 px-2.5 py-1.5 text-xs font-medium text-blue-700 transition hover:bg-blue-100">
                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                </svg>
                                            </a>
                                            <a href="{{ path('app_admin_produit_edit', {id: produit.id}) }}"
                                               title="Modifier"
                                               class="inline-flex items-center rounded-md bg-amber-50 px-2.5 py-1.5 text-xs font-medium text-amber-700 transition hover:bg-amber-100">
                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                </svg>
                                            </a>
                                            <button type="button"
                                                    title="Supprimer"
                                                    onclick="confirmerSuppression('{{ produit.nom }}', '{{ path('app_admin_produit_delete', {id: produit.id}) }}', '{{ csrf_token('delete_produit_' ~ produit.id) }}')"
                                                    class="inline-flex items-center rounded-md bg-red-50 px-2.5 py-1.5 text-xs font-medium text-red-700 transition hover:bg-red-100">
                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="px-4 py-12 text-center text-sm italic text-slate-400">
                                        Aucun produit enregistré pour le moment.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if total_pages > 1 %}
                <div class="mt-5 flex flex-col items-center justify-between gap-3 rounded-xl border border-blue-100 bg-white px-4 py-3 shadow-sm sm:flex-row">
                    <p class="text-xs text-slate-500">Page {{ current_page }} sur {{ total_pages }}</p>
                    <div class="flex items-center gap-2">
                        {% if current_page > 1 %}
                            <a href="{{ path('app_admin_produit_index', app.request.query.all|merge({page: current_page - 1})) }}" class="inline-flex items-center rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:bg-slate-50">
                                Précédent
                            </a>
                        {% else %}
                            <span class="inline-flex cursor-not-allowed items-center rounded-lg border border-slate-100 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-300">Précédent</span>
                        {% endif %}

                        {% for pageNumber in 1..total_pages %}
                            {% if pageNumber == current_page %}
                                <span class="inline-flex min-w-8 items-center justify-center rounded-lg bg-blue-700 px-2.5 py-1.5 text-xs font-semibold text-white">{{ pageNumber }}</span>
                            {% else %}
                                <a href="{{ path('app_admin_produit_index', app.request.query.all|merge({page: pageNumber})) }}" class="inline-flex min-w-8 items-center justify-center rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-semibold text-slate-600 transition hover:bg-slate-50">{{ pageNumber }}</a>
                            {% endif %}
                        {% endfor %}

                        {% if current_page < total_pages %}
                            <a href="{{ path('app_admin_produit_index', app.request.query.all|merge({page: current_page + 1})) }}" class="inline-flex items-center rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:bg-slate-50">
                                Suivant
                            </a>
                        {% else %}
                            <span class="inline-flex cursor-not-allowed items-center rounded-lg border border-slate-100 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-300">Suivant</span>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </main>
    </div>
</div>

{# Modal de confirmation de suppression #}
<div id="modal-suppression" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="mx-4 w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100">
            <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        </div>
        <h3 class="mb-2 text-lg font-bold text-slate-800">Confirmer la suppression</h3>
        <p class="mb-6 text-sm text-slate-600">
            Voulez-vous vraiment supprimer le produit <strong id="nom-produit" class="text-red-700"></strong> ?
            Cette action est irréversible.
        </p>
        <form id="form-suppression" method="POST">
            <input type="hidden" name="_token" id="csrf-suppression">
            <div class="flex gap-3">
                <button type="button" onclick="fermerModal()"
                        class="flex-1 rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                    Annuler
                </button>
                <button type="submit"
                        class="flex-1 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700">
                    Supprimer
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function confirmerSuppression(nom, url, token) {
    document.getElementById('nom-produit').textContent = nom;
    document.getElementById('form-suppression').action = url;
    document.getElementById('csrf-suppression').value = token;
    const modal = document.getElementById('modal-suppression');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function fermerModal() {
    const modal = document.getElementById('modal-suppression');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

document.getElementById('modal-suppression').addEventListener('click', function(e) {
    if (e.target === this) fermerModal();
});
</script>
{% endblock %}
