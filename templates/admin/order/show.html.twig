{% extends 'base.html.twig' %}

{% block title %}Commande #{{ order.id }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    {% include 'admin/partials/sidebar.html.twig' with { admin_sidebar_active: 'commandes' } %}

    <div class="mx-auto max-w-7xl px-5 py-8 lg:pl-80 lg:pr-8 lg:py-10">
        <main>
            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-lg px-4 py-3 text-sm font-medium
                        {% if label == 'success' %}bg-green-50 border border-green-200 text-green-800
                        {% else %}bg-red-50 border border-red-200 text-red-800{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {# En-tête #}
            <div class="mb-6 flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight text-blue-900">Commande #{{ order.id }}</h2>
                    <p class="mt-1 text-sm text-slate-500">Passée le {{ order.createdAt|date('d/m/Y à H:i') }}</p>
                </div>
                <a href="{{ path('admin_order_index') }}"
                   class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Retour à la liste
                </a>
            </div>

            <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
                {# Informations client #}
                <div class="lg:col-span-1">
                    <div class="rounded-xl border border-blue-100 bg-white p-6 shadow-sm">
                        <h3 class="text-lg font-semibold text-blue-900 mb-4">Informations client</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="text-sm font-medium text-slate-500">Nom</label>
                                <p class="text-sm text-slate-900">{{ order.user.prenom }} {{ order.user.nom }}</p>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-slate-500">Email</label>
                                <p class="text-sm text-slate-900">{{ order.user.email }}</p>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-slate-500">Téléphone</label>
                                <p class="text-sm text-slate-900">{{ order.user.tel }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Détails commande #}
                <div class="lg:col-span-2">
                    <div class="rounded-xl border border-blue-100 bg-white p-6 shadow-sm">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold text-blue-900">Détails de la commande</h3>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                                {% if order.statut.value == 'En attente' %}bg-yellow-100 text-yellow-800
                                {% elseif order.statut.value == 'En attente de paiement' %}bg-orange-100 text-orange-800
                                {% elseif order.statut.value == 'Payée' %}bg-blue-100 text-blue-800
                                {% elseif order.statut.value == 'Livrée' %}bg-green-100 text-green-800
                                {% else %}bg-red-100 text-red-800{% endif %}">
                                {{ order.statut.value }}
                            </span>
                        </div>

                        {# Produits #}
                        <div class="space-y-4 mb-6">
                            {% for ligne in order.ligneCommandes %}
                                <div class="flex items-center space-x-4 py-4 border-b border-blue-50 last:border-b-0">
                                    <div class="flex-shrink-0 w-12 h-12 bg-slate-200 rounded-md overflow-hidden">
                                        {% if ligne.produit.image %}
                                            <img src="{{ asset(ligne.produit.image) }}" alt="{{ ligne.produit.nom }}" class="w-full h-full object-cover">
                                        {% else %}
                                            <div class="w-full h-full flex items-center justify-center text-slate-400">
                                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                                </svg>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="text-sm font-medium text-slate-900">{{ ligne.produit.nom }}</h4>
                                        <p class="text-sm text-slate-500">{{ ligne.produit.marque }}</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm text-slate-900">Quantité: {{ ligne.quantite }}</p>
                                        <p class="text-sm font-medium text-slate-900">{{ ligne.prix|number_format(0, ',', ' ') }} GNF</p>
                                        <p class="text-sm font-medium text-blue-600">{{ (ligne.prix * ligne.quantite)|number_format(0, ',', ' ') }} GNF</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        {# Total #}
                        <div class="border-t border-blue-100 pt-4">
                            <div class="flex justify-between items-center">
                                <span class="text-lg font-semibold text-slate-900">Total</span>
                                <span class="text-lg font-bold text-blue-600">{{ order.montantTotal|number_format(0, ',', ' ') }} GNF</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Actions #}
            <div class="mt-6 rounded-xl border border-blue-100 bg-white p-6 shadow-sm">
                <h3 class="text-lg font-semibold text-blue-900 mb-4">Actions</h3>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    {# Changer statut #}
                    <div>
                        <h4 class="text-sm font-medium text-slate-900 mb-2">Changer le statut</h4>
                        <form method="post" action="{{ path('admin_order_update_status', {id: order.id}) }}" class="flex gap-2">
                            <select name="status" class="flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="En attente" {% if order.statut.value == 'En attente' %}selected{% endif %}>En attente</option>
                                <option value="En attente de paiement" {% if order.statut.value == 'En attente de paiement' %}selected{% endif %}>En attente de paiement</option>
                                <option value="Payée" {% if order.statut.value == 'Payée' %}selected{% endif %}>Payée</option>
                                <option value="Livrée" {% if order.statut.value == 'Livrée' %}selected{% endif %}>Livrée</option>
                                <option value="Annulée" {% if order.statut.value == 'Annulée' %}selected{% endif %}>Annulée</option>
                            </select>
                            <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
                                Mettre à jour
                            </button>
                        </form>
                    </div>

                    {# Supprimer #}
                    <div>
                        <h4 class="text-sm font-medium text-slate-900 mb-2">Actions dangereuses</h4>
                        <form method="post" action="{{ path('admin_order_delete', {id: order.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette commande ?')" class="flex gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                            <button type="submit" class="rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">
                                Supprimer la commande
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}