{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    {% include 'admin/partials/sidebar.html.twig' with { admin_sidebar_active: 'commandes' } %}

    <div class="mx-auto max-w-7xl px-5 py-8 lg:pl-80 lg:pr-8 lg:py-10">
        <main>
            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-lg px-4 py-3 text-sm font-medium
                        {% if label == 'success' %}bg-green-50 border border-green-200 text-green-800
                        {% else %}bg-red-50 border border-red-200 text-red-800{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {# En-tête #}
            <div class="mb-6 flex items-center justify-between">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight text-blue-900">Commandes</h2>
                    <p class="mt-1 text-sm text-slate-500">Gestion des commandes clients</p>
                </div>
            </div>

            {# Filtres #}
            <div class="mb-5">
                <form method="get" class="flex flex-wrap items-center gap-3">
                    <div class="flex items-center gap-2 rounded-xl border border-blue-100 bg-white px-4 py-2.5 shadow-sm">
                        <svg class="h-4 w-4 flex-shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"/>
                        </svg>
                        <select name="status" onchange="this.form.submit()" class="border-0 bg-transparent text-sm font-medium text-slate-700 focus:outline-none focus:ring-0">
                            <option value="">Tous les statuts</option>
                            <option value="En attente" {% if selected_status == 'En attente' %}selected{% endif %}>En attente</option>
                            <option value="En attente de paiement" {% if selected_status == 'En attente de paiement' %}selected{% endif %}>En attente de paiement</option>
                            <option value="Payée" {% if selected_status == 'Payée' %}selected{% endif %}>Payée</option>
                            <option value="Livrée" {% if selected_status == 'Livrée' %}selected{% endif %}>Livrée</option>
                            <option value="Annulée" {% if selected_status == 'Annulée' %}selected{% endif %}>Annulée</option>
                        </select>
                    </div>
                </form>
            </div>

            {# Liste des commandes #}
            <div class="overflow-hidden rounded-xl border border-blue-100 bg-white shadow-sm">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-blue-100">
                        <thead class="bg-blue-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-blue-700">Commande</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-blue-700">Client</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-blue-700">Montant</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-blue-700">Statut</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-blue-700">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-blue-700">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-blue-50 bg-white">
                            {% for order in orders %}
                                <tr class="hover:bg-blue-25">
                                    <td class="whitespace-nowrap px-6 py-4">
                                        <div class="text-sm font-medium text-blue-900">#{{ order.id }}</div>
                                        <div class="text-sm text-slate-500">{{ order.ligneCommandes|length }} article(s)</div>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4">
                                        <div class="text-sm font-medium text-slate-900">{{ order.user.prenom }} {{ order.user.nom }}</div>
                                        <div class="text-sm text-slate-500">{{ order.user.email }}</div>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4">
                                        <div class="text-sm font-medium text-slate-900">{{ order.montantTotal|number_format(0, ',', ' ') }} GNF</div>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                            {% if order.statut.value == 'En attente' %}bg-yellow-100 text-yellow-800
                                            {% elseif order.statut.value == 'En attente de paiement' %}bg-orange-100 text-orange-800
                                            {% elseif order.statut.value == 'Payée' %}bg-blue-100 text-blue-800
                                            {% elseif order.statut.value == 'Livrée' %}bg-green-100 text-green-800
                                            {% else %}bg-red-100 text-red-800{% endif %}">
                                            {{ order.statut.value }}
                                        </span>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4">
                                        <div class="text-sm text-slate-900">{{ order.createdAt|date('d/m/Y') }}</div>
                                        <div class="text-sm text-slate-500">{{ order.createdAt|date('H:i') }}</div>
                                    </td>
                                    <td class="whitespace-nowrap px-6 py-4 text-sm font-medium">
                                        <a href="{{ path('admin_order_show', {id: order.id}) }}"
                                           class="text-blue-600 hover:text-blue-900">Voir</a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center">
                                        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                        <h3 class="mt-2 text-sm font-medium text-slate-900">Aucune commande</h3>
                                        <p class="mt-1 text-sm text-slate-500">Il n'y a pas encore de commandes.</p>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# Pagination #}
            {% if total_pages > 1 %}
                <div class="mt-6 flex items-center justify-between">
                    <div class="text-sm text-slate-700">
                        Page {{ current_page }} sur {{ total_pages }}
                    </div>
                    <div class="flex items-center space-x-2">
                        {% if current_page > 1 %}
                            <a href="{{ path('admin_order_index', {page: current_page - 1, status: selected_status}) }}"
                               class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                Précédent
                            </a>
                        {% endif %}

                        {# Numéros de page #}
                        {% set start_page = max(1, current_page - 2) %}
                        {% set end_page = min(total_pages, current_page + 2) %}

                        {% if start_page > 1 %}
                            <a href="{{ path('admin_order_index', {page: 1, status: selected_status}) }}"
                               class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                1
                            </a>
                            {% if start_page > 2 %}
                                <span class="px-2 py-2 text-sm text-slate-500">...</span>
                            {% endif %}
                        {% endif %}

                        {% for page_num in start_page..end_page %}
                            {% if page_num == current_page %}
                                <span class="rounded-md border border-blue-500 bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700">
                                    {{ page_num }}
                                </span>
                            {% else %}
                                <a href="{{ path('admin_order_index', {page: page_num, status: selected_status}) }}"
                                   class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                    {{ page_num }}
                                </a>
                            {% endif %}
                        {% endfor %}

                        {% if end_page < total_pages %}
                            {% if end_page < total_pages - 1 %}
                                <span class="px-2 py-2 text-sm text-slate-500">...</span>
                            {% endif %}
                            <a href="{{ path('admin_order_index', {page: total_pages, status: selected_status}) }}"
                               class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                {{ total_pages }}
                            </a>
                        {% endif %}

                        {% if current_page < total_pages %}
                            <a href="{{ path('admin_order_index', {page: current_page + 1, status: selected_status}) }}"
                               class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                Suivant
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </main>
    </div>
</div>
{% endblock %}