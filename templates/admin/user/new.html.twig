{% extends 'admin/base.html.twig' %}

{% block title %}Créer un administrateur{% endblock %}

{% block admin_content %}
    <header class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-blue-900">Créer un administrateur</h1>
            <p class="mt-2 text-sm text-slate-600">Ajoutez un nouvel administrateur qui pourra se connecter au back-office.</p>
        </div>

        <div class="flex items-center gap-2">
            <a href="{{ path('app_admin_user_index') }}" class="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm transition hover:bg-blue-50">Retour à la liste</a>
        </div>
    </header>

    <style>
        .registration-field:has(input:not(:placeholder-shown)) .field-icon { opacity: 0; pointer-events: none; }
        .registration-field .field-icon { transition: opacity 0.2s ease; }
        .registration-field input::placeholder { color: transparent; }
        .registration-field input { transition: padding-left 0.2s ease; }
        .registration-field:has(input:not(:placeholder-shown)) input { padding-left: 0.75rem; }
    </style>

    <section class="mt-6 w-full max-w-xl">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-3 px-3 py-2 rounded-lg text-xs font-medium {{ label == 'success' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-800 border border-red-200' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="relative py-3 w-full px-1 sm:px-0">
            <div class="absolute inset-0 bg-gradient-to-r from-blue-700 via-blue-800 to-blue-900 shadow-2xl transform -skew-y-3 sm:skew-y-0 sm:-rotate-2 sm:rounded-3xl opacity-90"></div>
            <div class="relative bg-white/95 backdrop-blur shadow-2xl rounded-3xl p-6 sm:p-8 border border-blue-100">
                {{ form_start(userForm, {'attr': {'class': 'space-y-4', 'data-turbo': 'false'}}) }}
                    <div class="relative">
                        {{ form_label(userForm.prenom, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-800 focus-within:ring-2 focus-within:ring-blue-900/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </span>
                            {{ form_widget(userForm.prenom, {'attr': {'class': 'w-full pl-9 pr-3 py-2.5 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(userForm.prenom) }}
                    </div>

                    <div class="relative">
                        {{ form_label(userForm.nom, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-800 focus-within:ring-2 focus-within:ring-blue-900/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </span>
                            {{ form_widget(userForm.nom, {'attr': {'class': 'w-full pl-9 pr-3 py-2.5 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(userForm.nom) }}
                    </div>

                    <div class="relative">
                        {{ form_label(userForm.email, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-800 focus-within:ring-2 focus-within:ring-blue-900/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </span>
                            {{ form_widget(userForm.email, {'attr': {'class': 'w-full pl-9 pr-3 py-2.5 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(userForm.email) }}
                    </div>

                    <div class="relative">
                        {{ form_label(userForm.tel, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-800 focus-within:ring-2 focus-within:ring-blue-900/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V21a2 2 0 01-2 2h-1C9.716 23 3 16.284 3 8V5z"/></svg>
                            </span>
                            {{ form_widget(userForm.tel, {'attr': {'class': 'w-full pl-9 pr-3 py-2.5 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(userForm.tel) }}
                    </div>

                    <div class="relative">
                        {{ form_label(userForm.plainPassword.first, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-800 focus-within:ring-2 focus-within:ring-blue-900/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            </span>
                            {{ form_widget(userForm.plainPassword.first, {'attr': {'class': 'w-full pl-9 pr-3 py-2.5 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' ', 'autocomplete': 'new-password'}}) }}
                        </div>
                        {{ form_errors(userForm.plainPassword.first) }}
                    </div>

                    <div class="relative">
                        {{ form_label(userForm.plainPassword.second, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-800 focus-within:ring-2 focus-within:ring-blue-900/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            </span>
                            {{ form_widget(userForm.plainPassword.second, {'attr': {'class': 'w-full pl-9 pr-3 py-2.5 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' ', 'autocomplete': 'new-password'}}) }}
                        </div>
                        {{ form_errors(userForm.plainPassword.second) }}
                    </div>

                    <div class="pt-1">
                        {{ form_widget(userForm.submit, {
                            'attr': {'class': 'w-full bg-gradient-to-r from-blue-800 to-blue-900 hover:from-blue-900 hover:to-slate-900 text-white text-base font-semibold py-3 px-3 rounded-xl shadow-lg shadow-blue-900/30 hover:shadow-xl hover:shadow-blue-900/40 transition-all duration-200'}
                        }) }}
                    </div>
                {{ form_end(userForm) }}
            </div>
        </div>
    </section>
{% endblock %}
