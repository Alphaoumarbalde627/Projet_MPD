{% extends 'admin/base.html.twig' %}

{% block title %}Détails utilisateur{% endblock %}

{% block admin_content %}
    <header class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-blue-900">Détails de l'utilisateur</h1>
            <p class="mt-2 text-sm text-slate-600">Informations de base et historique.</p>
        </div>

        <div class="flex items-center gap-2">
            <a href="{{ path('app_admin_user_index') }}" class="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm transition hover:bg-blue-50">Retour à la liste</a>
        </div>
    </header>

    <section class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-blue-100 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-blue-800">Informations générales</h2>
            <dl class="mt-4 space-y-4 text-sm text-slate-700">
                <div class="flex justify-between">
                    <dt class="font-medium text-slate-600">Nom / Prénom</dt>
                    <dd class="font-semibold text-slate-800">{{ user.prenom }} {{ user.nom }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-medium text-slate-600">Email</dt>
                    <dd class="font-semibold text-slate-800">{{ user.email }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-medium text-slate-600">Téléphone</dt>
                    <dd class="font-semibold text-slate-800">{{ user.tel }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-medium text-slate-600">Rôle</dt>
                    <dd class="font-semibold text-slate-800">{{ 'ROLE_ADMIN' in user.roles ? 'ROLE_ADMIN' : 'ROLE_USER' }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="font-medium text-slate-600">Inscrit le</dt>
                    <dd class="font-semibold text-slate-800">{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '-' }}</dd>
                </div>
                {% if user.createdBy %}
                    <div class="flex justify-between">
                        <dt class="font-medium text-slate-600">Créé par</dt>
                        <dd class="font-semibold text-slate-800">{{ user.createdBy.prenom }} {{ user.createdBy.nom }}</dd>
                    </div>
                {% endif %}
            </dl>

            {% if is_granted('USER_DELETE', user) %}
                <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" class="mt-6">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-user' ~ user.id) }}">
                    <button type="submit" class="inline-flex items-center gap-2 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700" onclick="return confirm('Confirmer la suppression de cet utilisateur ?');">
                        Supprimer cet utilisateur
                    </button>
                </form>
            {% endif %}
        </div>

        <div class="rounded-xl border border-blue-100 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-blue-800">Statut</h2>
            <div class="mt-4 space-y-3 text-sm text-slate-700">
                <div class="flex justify-between">
                    <span class="font-medium text-slate-600">Dernière mise à jour</span>
                    <span class="font-semibold text-slate-800">{{ user.updatedAt ? user.updatedAt|date('d/m/Y H:i') : '-' }}</span>
                </div>
                <div class="flex justify-between">
                    <span class="font-medium text-slate-600">ID</span>
                    <span class="font-semibold text-slate-800">#{{ user.id }}</span>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
