{% extends 'base.html.twig' %}

{% block title %}Espace Administrateur{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    <aside class="hidden lg:fixed lg:inset-y-0 lg:left-0 lg:block lg:w-72 lg:bg-gradient-to-b lg:from-blue-950 lg:via-blue-900 lg:to-blue-800 lg:p-6 lg:text-blue-50 lg:shadow-2xl">
        <div class="flex h-full flex-col">
            <div class="mb-7 border-b border-blue-300/25 pb-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-blue-200/90">Espace Admin</p>
                <h1 class="mt-2 text-[28px] font-extrabold leading-tight text-white">Galerie MPD</h1>
                <p class="mt-2 text-[13px] font-medium leading-relaxed text-blue-100/85">Gestion centralisée des modules</p>
            </div>

            <nav class="space-y-1">
                <a href="{{ path('app_admin_dashboard') }}" class="flex items-center justify-between rounded-lg bg-gradient-to-r from-blue-500/35 to-cyan-400/25 px-4 py-2.5 text-[15px] font-semibold tracking-[0.01em] text-white ring-1 ring-blue-200/60">
                    <span>Tableau de bord</span>
                    <span class="text-sm text-cyan-200">•</span>
                </a>
                <a href="{{ path('app_admin_user_index') }}" class="block rounded-lg px-4 py-2.5 text-[15px] font-medium tracking-[0.01em] text-blue-100/90 transition hover:bg-white/10 hover:text-white">Utilisateurs</a>
                <a href="{{ path('app_admin_profile_edit') }}" class="block rounded-lg px-4 py-2.5 text-[15px] font-medium tracking-[0.01em] text-blue-100/90 transition hover:bg-white/10 hover:text-white">Profil</a>
                <a href="/admin/produits" class="block rounded-lg px-4 py-2.5 text-[15px] font-medium tracking-[0.01em] text-blue-100/90 transition hover:bg-white/10 hover:text-white">Produits</a>
                <a href="/admin/services" class="block rounded-lg px-4 py-2.5 text-[15px] font-medium tracking-[0.01em] text-blue-100/90 transition hover:bg-white/10 hover:text-white">Services</a>
                <a href="/admin/categories" class="block rounded-lg px-4 py-2.5 text-[15px] font-medium tracking-[0.01em] text-blue-100/90 transition hover:bg-white/10 hover:text-white">Catégories</a>
                <a href="/admin/commandes" class="block rounded-lg px-4 py-2.5 text-[15px] font-medium tracking-[0.01em] text-blue-100/90 transition hover:bg-white/10 hover:text-white">Commandes</a>
                <a href="/admin/promotions" class="block rounded-lg px-4 py-2.5 text-[15px] font-medium tracking-[0.01em] text-blue-100/90 transition hover:bg-white/10 hover:text-white">Promotions</a>
            </nav>

            <div class="mt-auto pt-6">
                <a href="{{ path('_logout_main') }}" class="flex items-center justify-center rounded-lg border border-red-300/40 bg-red-500/10 px-4 py-2.5 text-sm font-semibold text-red-100 transition hover:bg-red-500/20 hover:text-white">
                    Déconnexion
                </a>
            </div>
        </div>
    </aside>

    <div class="mx-auto max-w-7xl px-5 py-8 lg:pl-80 lg:pr-8 lg:py-10">
        <main class="space-y-7">
            {% block admin_content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}
