{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    {% include 'admin/partials/sidebar.html.twig' with { admin_sidebar_active: 'dashboard' } %}

    <div class="mx-auto max-w-7xl px-5 py-8 lg:pl-80 lg:pr-8 lg:py-10">
        <main class="space-y-7">
            <section>
                <h2 class="mb-5 text-3xl font-bold tracking-tight text-blue-900">Statistiques globales</h2>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
                    <article class="rounded-xl border border-blue-200/70 bg-gradient-to-br from-white to-blue-50 p-5 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Utilisateurs</p>
                        <p class="mt-2 text-4xl font-extrabold leading-none text-blue-900">{{ stats.users }}</p>
                        <p class="mt-2 text-sm font-medium text-slate-600">Comptes enregistrés</p>
                    </article>
                    <article class="rounded-xl border border-blue-200/70 bg-gradient-to-br from-white to-blue-50 p-5 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Produits</p>
                        <p class="mt-2 text-4xl font-extrabold leading-none text-blue-900">{{ stats.products }}</p>
                        <p class="mt-2 text-sm font-medium text-slate-600">Catalogue marchand</p>
                    </article>
                    <article class="rounded-xl border border-blue-200/70 bg-gradient-to-br from-white to-blue-50 p-5 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Services</p>
                        <p class="mt-2 text-4xl font-extrabold leading-none text-blue-900">{{ stats.services }}</p>
                        <p class="mt-2 text-sm font-medium text-slate-600">Offres actives</p>
                    </article>
                    <article class="rounded-xl border border-blue-200/70 bg-gradient-to-br from-white to-blue-50 p-5 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Catégories</p>
                        <p class="mt-2 text-4xl font-extrabold leading-none text-blue-900">{{ stats.categories }}</p>
                        <p class="mt-2 text-sm font-medium text-slate-600">Structuration du catalogue</p>
                    </article>
                </div>
            </section>

            <section>
                <h2 class="mb-5 text-3xl font-bold tracking-tight text-blue-900">Accès rapide</h2>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
                    <a href="/admin/users" class="rounded-xl border border-blue-200 bg-gradient-to-r from-white to-blue-50 px-5 py-4 text-base font-semibold leading-tight text-blue-900 shadow-sm transition hover:from-blue-50 hover:to-blue-100">Gérer les utilisateurs</a>
                    <a href="/admin/produits" class="rounded-xl border border-blue-200 bg-gradient-to-r from-white to-blue-50 px-5 py-4 text-base font-semibold leading-tight text-blue-900 shadow-sm transition hover:from-blue-50 hover:to-blue-100">Gérer les produits</a>
                    <a href="{{ path('app_admin_temoignage_index') }}" class="rounded-xl border border-blue-200 bg-gradient-to-r from-white to-blue-50 px-5 py-4 text-base font-semibold leading-tight text-blue-900 shadow-sm transition hover:from-blue-50 hover:to-blue-100">Gérer les temoignages</a>
                    <a href="/admin/services" class="rounded-xl border border-blue-200 bg-gradient-to-r from-white to-blue-50 px-5 py-4 text-base font-semibold leading-tight text-blue-900 shadow-sm transition hover:from-blue-50 hover:to-blue-100">Gérer les services</a>
                </div>
            </section>

            <section>
                <h2 class="mb-5 text-3xl font-bold tracking-tight text-blue-900">Informations récentes</h2>
                <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
                    <article class="rounded-xl border border-blue-100 bg-white p-5 shadow-sm">
                        <h3 class="mb-4 text-base font-semibold tracking-tight text-blue-800">Derniers utilisateurs</h3>
                        <ul class="space-y-2.5 text-sm text-slate-700">
                            {% for user in last_users %}
                                <li class="flex items-center justify-between rounded-md border border-blue-100 bg-gradient-to-r from-blue-50 to-white px-3 py-2">
                                    <span class="font-semibold text-slate-800">{{ user.prenom }} {{ user.nom }}</span>
                                    <span class="text-xs font-semibold text-blue-700">#{{ user.id }}</span>
                                </li>
                            {% else %}
                                <li class="text-sm italic text-slate-500">Aucun utilisateur.</li>
                            {% endfor %}
                        </ul>
                    </article>

                    <article class="rounded-xl border border-blue-100 bg-white p-5 shadow-sm">
                        <h3 class="mb-4 text-base font-semibold tracking-tight text-blue-800">Derniers produits</h3>
                        <ul class="space-y-2.5 text-sm text-slate-700">
                            {% for product in last_products %}
                                <li class="flex items-center justify-between rounded-md border border-blue-100 bg-gradient-to-r from-blue-50 to-white px-3 py-2">
                                    <span class="font-semibold text-slate-800">{{ product.nom }}</span>
                                    <span class="text-xs font-semibold text-blue-700">#{{ product.id }}</span>
                                </li>
                            {% else %}
                                <li class="text-sm italic text-slate-500">Aucun produit.</li>
                            {% endfor %}
                        </ul>
                    </article>

                    <article class="rounded-xl border border-blue-100 bg-white p-5 shadow-sm">
                        <h3 class="mb-4 text-base font-semibold tracking-tight text-blue-800">Derniers services</h3>
                        <ul class="space-y-2.5 text-sm text-slate-700">
                            {% for service in last_services %}
                                <li class="flex items-center justify-between rounded-md border border-blue-100 bg-gradient-to-r from-blue-50 to-white px-3 py-2">
                                    <span class="font-semibold text-slate-800">{{ service.nom }}</span>
                                    <span class="text-xs font-semibold text-blue-700">#{{ service.id }}</span>
                                </li>
                            {% else %}
                                <li class="text-sm italic text-slate-500">Aucun service.</li>
                            {% endfor %}
                        </ul>
                    </article>
                </div>
            </section>
        </main>
    </div>
</div>
{% endblock %}
