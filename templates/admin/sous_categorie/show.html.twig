{% extends 'base.html.twig' %}

{% block title %}Detail sous-categorie{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    <div class="mx-auto max-w-5xl px-5 py-8 lg:py-10">
        <nav class="mb-6 flex items-center gap-2 text-sm text-slate-500">
            <a href="{{ path('app_admin_sous_categorie_index') }}" class="font-medium text-blue-700 hover:underline">Sous-categories</a>
            <span>/</span>
            <span>{{ sous_categorie.nom }}</span>
        </nav>

        <div class="rounded-xl border border-blue-100 bg-white p-6 shadow-sm">
            <h1 class="text-2xl font-bold text-slate-800">{{ sous_categorie.nom }}</h1>
            <dl class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-xs font-medium text-slate-400">Categorie parente</dt>
                    <dd class="mt-1 text-sm font-semibold text-slate-700">{{ sous_categorie.category ? sous_categorie.category.nom : '—' }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-400">Cree le</dt>
                    <dd class="mt-1 text-sm font-semibold text-slate-700">{{ sous_categorie.createdAt ? sous_categorie.createdAt|date('d/m/Y H:i') : '—' }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-400">Mis a jour le</dt>
                    <dd class="mt-1 text-sm font-semibold text-slate-700">{{ sous_categorie.updatedAt ? sous_categorie.updatedAt|date('d/m/Y H:i') : '—' }}</dd>
                </div>
            </dl>

            <div class="mt-6 flex flex-wrap gap-3">
                <a href="{{ path('app_admin_sous_categorie_edit', {id: sous_categorie.id}) }}" class="inline-flex items-center rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-amber-700">Modifier</a>
                <form method="post" action="{{ path('app_admin_sous_categorie_delete', {id: sous_categorie.id}) }}" onsubmit="return confirm('Confirmer la suppression de cette sous-categorie ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_sous_categorie_' ~ sous_categorie.id) }}">
                    <button type="submit" class="inline-flex items-center rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-red-700">Supprimer</button>
                </form>
                <a href="{{ path('app_admin_sous_categorie_index') }}" class="inline-flex items-center rounded-lg border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Retour</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
