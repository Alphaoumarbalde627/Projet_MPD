{% extends 'base.html.twig' %}

{% block title %}Gestion des Sous-categories{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    {% include 'admin/partials/sidebar.html.twig' with { admin_sidebar_active: 'sous-categories' } %}

    <div class="mx-auto max-w-7xl px-5 py-8 lg:pl-80 lg:pr-8 lg:py-10">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-lg px-4 py-3 text-sm font-medium {% if label == 'success' %}bg-green-50 border border-green-200 text-green-800{% else %}bg-red-50 border border-red-200 text-red-800{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="mb-6 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-blue-900">Sous-categories</h1>
                <p class="mt-1 text-sm text-slate-500">{{ sous_categories|length }} sous-categorie(s)</p>
            </div>
            <a href="{{ path('app_admin_sous_categorie_new') }}" class="inline-flex items-center gap-2 rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-800">
                Nouveau
            </a>
        </div>

        <div class="overflow-hidden rounded-xl border border-blue-100 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-blue-100">
                    <thead class="bg-gradient-to-r from-blue-50 to-white">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Nom</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Categorie parente</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Cree le</th>
                            <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-blue-50">
                        {% for sous_categorie in sous_categories %}
                            <tr class="transition hover:bg-blue-50/40">
                                <td class="px-4 py-3 font-semibold text-slate-800">{{ sous_categorie.nom }}</td>
                                <td class="px-4 py-3 text-sm text-slate-600">{{ sous_categorie.category ? sous_categorie.category.nom : '—' }}</td>
                                <td class="px-4 py-3 text-sm text-slate-600">{{ sous_categorie.createdAt ? sous_categorie.createdAt|date('d/m/Y') : '—' }}</td>
                                <td class="px-4 py-3">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="{{ path('app_admin_sous_categorie_show', {id: sous_categorie.id}) }}" class="inline-flex items-center rounded-md bg-blue-50 px-2.5 py-1.5 text-xs font-medium text-blue-700 transition hover:bg-blue-100">Voir</a>
                                        <a href="{{ path('app_admin_sous_categorie_edit', {id: sous_categorie.id}) }}" class="inline-flex items-center rounded-md bg-amber-50 px-2.5 py-1.5 text-xs font-medium text-amber-700 transition hover:bg-amber-100">Modifier</a>
                                        <form method="post" action="{{ path('app_admin_sous_categorie_delete', {id: sous_categorie.id}) }}" onsubmit="return confirm('Confirmer la suppression de cette sous-categorie ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_sous_categorie_' ~ sous_categorie.id) }}">
                                            <button type="submit" class="inline-flex items-center rounded-md bg-red-50 px-2.5 py-1.5 text-xs font-medium text-red-700 transition hover:bg-red-100">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="px-4 py-12 text-center text-sm italic text-slate-400">Aucune sous-categorie.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
