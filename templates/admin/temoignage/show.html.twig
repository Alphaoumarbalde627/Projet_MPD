{% extends 'base.html.twig' %}

{% block title %}Detail temoignage{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    <div class="mx-auto max-w-5xl px-5 py-8 lg:py-10">
        <nav class="mb-6 flex items-center gap-2 text-sm text-slate-500">
            <a href="{{ path('app_admin_temoignage_index') }}" class="font-medium text-blue-700 hover:underline">Temoignages</a>
            <span>/</span>
            <span>Detail</span>
        </nav>

        <div class="rounded-2xl border border-blue-100 bg-white p-6 shadow-sm">
            <h1 class="mb-5 text-2xl font-bold text-blue-900">{{ temoignage.nomClient }}</h1>

            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <div>
                    <video class="h-64 w-full rounded-xl border border-slate-200 bg-black" controls>
                        <source src="{{ asset(temoignage.video) }}" type="video/mp4">
                    </video>
                </div>
                <div class="space-y-3 text-sm text-slate-700">
                    <p><strong>Produit:</strong> {{ temoignage.produit ? temoignage.produit.nom : '—' }}</p>
                    <p><strong>Fonction:</strong> {{ temoignage.fonctionClient ?: 'Non renseignee' }}</p>
                    <p><strong>Note:</strong> {{ temoignage.note }}/5</p>
                    <p><strong>Ordre:</strong> {{ temoignage.ordreAffichage }}</p>
                    <p><strong>Statut:</strong>
                        {% if temoignage.estActif %}
                            <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700">✅ Publie</span>
                        {% else %}
                            <span class="inline-flex items-center rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-semibold text-orange-700">⏳ En attente de validation</span>
                        {% endif %}
                    </p>
                    <p><strong>Commentaire:</strong> {{ temoignage.contenu ?: 'Aucun commentaire' }}</p>
                </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-3">
                <a href="{{ path('app_admin_temoignage_index') }}" class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">← Retour</a>
                <form method="post" action="{{ path('app_admin_temoignage_valider', {id: temoignage.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('valider_temoignage_' ~ temoignage.id) }}">
                    {% if temoignage.estActif %}
                        <button type="submit" class="inline-flex items-center rounded-lg bg-orange-100 px-4 py-2 text-sm font-semibold text-orange-700 transition hover:bg-orange-200">🚫 Desactiver</button>
                    {% else %}
                        <button type="submit" class="inline-flex items-center rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-green-700">✅ Valider et publier</button>
                    {% endif %}
                </form>
                <form method="post" action="{{ path('app_admin_temoignage_delete', {id: temoignage.id}) }}" onsubmit="return confirm('Supprimer definitivement ce temoignage ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_temoignage_' ~ temoignage.id) }}">
                    <button type="submit" class="inline-flex items-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700">🗑️ Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
