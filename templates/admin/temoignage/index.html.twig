{% extends 'base.html.twig' %}

{% block title %}Gestion des Temoignages{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-blue-50 via-white to-blue-50">
    {% include 'admin/partials/sidebar.html.twig' with { admin_sidebar_active: 'temoignages' } %}

    <div class="mx-auto max-w-7xl px-5 py-8 lg:pl-80 lg:pr-8 lg:py-10">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-lg px-4 py-3 text-sm font-medium {% if label == 'success' %}bg-green-50 border border-green-200 text-green-800{% else %}bg-red-50 border border-red-200 text-red-800{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="mb-6 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-blue-900">Temoignages videos</h1>
                <p class="mt-1 text-sm text-slate-500">{{ temoignages|length }} temoignage(s) au total</p>
            </div>
            {% set enAttente = temoignages|filter(t => not t.estActif)|length %}
            {% if enAttente > 0 %}
                <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-100 px-4 py-2 text-sm font-bold text-orange-700">
                    ⏳ {{ enAttente }} en attente de validation
                </span>
            {% endif %}
        </div>

        <div class="overflow-hidden rounded-xl border border-blue-100 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-blue-100">
                    <thead class="bg-gradient-to-r from-blue-50 to-white">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Video</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Client</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Produit</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Note</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Statut</th>
                            <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-blue-50">
                        {% for temoignage in temoignages %}
                            <tr class="transition hover:bg-blue-50/40">
                                <td class="px-4 py-3 text-sm text-slate-600">
                                    <video class="h-14 w-24 rounded-md border border-slate-200 bg-black" preload="metadata" controls>
                                        <source src="{{ asset(temoignage.video) }}" type="video/mp4">
                                    </video>
                                </td>
                                <td class="px-4 py-3">
                                    <p class="font-semibold text-slate-800">{{ temoignage.nomClient }}</p>
                                    <p class="text-xs text-slate-500">{{ temoignage.fonctionClient ?: 'Non renseigne' }}</p>
                                </td>
                                <td class="px-4 py-3 text-sm text-slate-700">{{ temoignage.produit ? temoignage.produit.nom : '—' }}</td>
                                <td class="px-4 py-3 text-sm text-amber-500">
                                    {% for i in 1..temoignage.note %}★{% endfor %}
                                </td>
                                <td class="px-4 py-3">
                                    {% if temoignage.estActif %}
                                        <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700">✅ Publie</span>
                                    {% else %}
                                        <span class="inline-flex items-center rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-semibold text-orange-700">⏳ En attente</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="{{ path('app_admin_temoignage_show', {id: temoignage.id}) }}" class="inline-flex items-center rounded-md bg-blue-50 px-2.5 py-1.5 text-xs font-medium text-blue-700 transition hover:bg-blue-100">Voir</a>
                                        <form method="post" action="{{ path('app_admin_temoignage_valider', {id: temoignage.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('valider_temoignage_' ~ temoignage.id) }}">
                                            {% if temoignage.estActif %}
                                                <button type="submit" class="inline-flex items-center rounded-md bg-orange-50 px-2.5 py-1.5 text-xs font-medium text-orange-700 transition hover:bg-orange-100">Desactiver</button>
                                            {% else %}
                                                <button type="submit" class="inline-flex items-center rounded-md bg-green-50 px-2.5 py-1.5 text-xs font-medium text-green-700 transition hover:bg-green-100">✅ Valider</button>
                                            {% endif %}
                                        </form>
                                        <form method="post" action="{{ path('app_admin_temoignage_delete', {id: temoignage.id}) }}" onsubmit="return confirm('Supprimer definitivement ce temoignage ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_temoignage_' ~ temoignage.id) }}">
                                            <button type="submit" class="inline-flex items-center rounded-md bg-red-50 px-2.5 py-1.5 text-xs font-medium text-red-700 transition hover:bg-red-100">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500">Aucun temoignage trouve.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
