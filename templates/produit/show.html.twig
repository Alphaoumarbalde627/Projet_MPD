{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} — Galerie MPD{% endblock %}

{% block body %}
{% include 'partials/headers.html.twig' %}

<section class="bg-gradient-to-b from-blue-50 to-white py-12">
    <div class="container mx-auto px-6">
        {# Fil d'Ariane #}
        <nav class="mb-8 flex items-center gap-2 text-sm text-slate-500">
            <a href="{{ path('app_home') }}" class="text-blue-700 hover:underline">Accueil</a>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <a href="{{ path('app_produit_index') }}" class="text-blue-700 hover:underline">Produits</a>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span>{{ produit.nom }}</span>
        </nav>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
            {# Image #}
            <div class="overflow-hidden rounded-2xl border border-blue-100 bg-white shadow-sm">
                {% if produit.image %}
                    <img src="{{ asset(produit.image) }}" alt="{{ produit.nom }}"
                         class="h-full max-h-[480px] w-full object-cover">
                {% else %}
                    <div class="flex h-80 w-full items-center justify-center bg-gradient-to-br from-blue-50 to-white">
                        <svg class="h-24 w-24 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                    </div>
                {% endif %}
            </div>

            {# Détails produit #}
            <div class="flex flex-col justify-between space-y-6">
                <div>
                    {# Catégories #}
                    <div class="mb-3 flex flex-wrap gap-2">
                        {% if produit.sousCategorie and produit.sousCategorie.category %}
                            <span class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">
                                {{ produit.sousCategorie.category.nom }}
                            </span>
                        {% endif %}
                        {% if produit.sousCategorie %}
                            <span class="inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-500">
                                {{ produit.sousCategorie.nom }}
                            </span>
                        {% endif %}
                    </div>

                    <h1 class="text-3xl font-extrabold text-blue-900">{{ produit.nom }}</h1>

                    {% if produit.marque %}
                        <p class="mt-2 text-sm font-medium text-slate-500">Marque : <span class="text-slate-700">{{ produit.marque }}</span></p>
                    {% endif %}
                    <p class="mt-1 text-xs text-slate-400">Réf. {{ produit.reference }}</p>

                    <p class="mt-4 text-4xl font-extrabold text-blue-700">
                        {{ produit.prix|number_format(0, ',', ' ') }}
                        <span class="text-lg font-semibold text-slate-500">GNF</span>
                    </p>

                    {# Stock #}
                    <div class="mt-3">
                        {% if produit.quantiteStock > 10 %}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-700">
                                <span class="h-2 w-2 rounded-full bg-green-500"></span>
                                En stock ({{ produit.quantiteStock }} disponibles)
                            </span>
                        {% elseif produit.quantiteStock > 0 %}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-100 px-3 py-1 text-sm font-semibold text-orange-700">
                                <span class="h-2 w-2 rounded-full bg-orange-500"></span>
                                Stock limité ({{ produit.quantiteStock }} restants)
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-red-100 px-3 py-1 text-sm font-semibold text-red-700">
                                <span class="h-2 w-2 rounded-full bg-red-500"></span>
                                Rupture de stock
                            </span>
                        {% endif %}
                    </div>

                    {# Description #}
                    <div class="mt-6">
                        <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Description</h2>
                        <p class="text-sm leading-relaxed text-slate-600">{{ produit.description }}</p>
                    </div>
                </div>
                {# Boutons #}
                <div class="flex flex-col gap-2.5">
                    {% if produit.quantiteStock > 0 %}
                        <a href="{{ path('app_cart_add', {id: produit.id}) }}"
                           class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-blue-800 px-6 py-2.5 text-sm font-bold text-white shadow transition hover:from-blue-700 hover:to-blue-900 hover:shadow-md">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            Ajouter au panier
                        </a>
                    {% else %}
                        <button disabled
                                class="flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-6 py-2.5 text-sm font-bold text-slate-400 cursor-not-allowed">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                            </svg>
                            Indisponible
                        </button>
                    {% endif %}
                    <div class="flex gap-2.5">
                        <a href="{{ path('app_temoignage_new', {id: produit.id}) }}"
                           class="flex flex-1 items-center justify-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                            Témoigner
                        </a>
                        <a href="{{ path('app_produit_index') }}"
                           class="flex flex-1 items-center justify-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 shadow-sm transition hover:bg-slate-50 hover:border-slate-400">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Retour au catalogue
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% include 'partials/footer.html.twig' ignore missing %}
{% endblock %}
