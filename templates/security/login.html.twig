{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
{% include 'partials/headers.html.twig' %}
<div class="min-h-screen bg-gray-100 pt-16 pb-10 flex flex-col justify-center sm:pt-20 sm:pb-12">
    <div class="relative py-3 w-full max-w-md mx-auto px-3 sm:px-4">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-700 via-blue-800 to-blue-900 shadow-2xl transform -skew-y-3 sm:skew-y-0 sm:-rotate-3 sm:rounded-3xl opacity-95"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-blue-800 shadow-xl transform skew-y-3 sm:skew-y-0 sm:rotate-3 sm:rounded-3xl opacity-80 -z-10"></div>
        <div class="relative px-5 py-7 bg-white/95 backdrop-blur shadow-2xl sm:rounded-3xl sm:p-8">
            <div class="mx-auto">
                <div class="text-center mb-5">
                    <h1 class="text-2xl font-bold bg-gradient-to-r from-blue-800 to-blue-900 bg-clip-text text-transparent">Connexion</h1>
                    <p class="mt-1 text-sm text-gray-500">Accédez à votre espace Galerie MPD</p>
                </div>

                {% if error %}
                    <div class="mb-3 px-3 py-2 rounded-lg text-xs font-medium bg-red-50 text-red-800 border border-red-200">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" class="space-y-4" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="relative">
                        <label for="email" class="block text-xs font-medium text-gray-700 mb-1">Adresse email</label>
                        <div class="relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-800 focus-within:ring-2 focus-within:ring-blue-900/20 transition">
                            <span class="absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </span>
                            <input
                                type="email"
                                name="_username"
                                id="email"
                                value="{{ last_username }}"
                                required
                                autofocus
                                autocomplete="email"
                                placeholder="exemple@domaine.com"
                                class="w-full pl-9 pr-3 py-2.5 rounded-lg text-sm text-gray-900 focus:outline-none border-0"
                            >
                        </div>
                    </div>

                    <div class="relative">
                        <label for="password" class="block text-xs font-medium text-gray-700 mb-1">Mot de passe</label>
                        <div class="relative">
                            <div class="relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-800 focus-within:ring-2 focus-within:ring-blue-900/20 transition">
                                <span class="absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                </span>
                                <input
                                    type="password"
                                    name="_password"
                                    id="password"
                                    required
                                    autocomplete="current-password"
                                    placeholder="••••••••"
                                    class="w-full pl-9 pr-10 py-2.5 rounded-lg text-sm text-gray-900 focus:outline-none border-0"
                                >
                                <button
                                    type="button"
                                    id="toggle-password"
                                    class="absolute inset-y-0 right-0 inline-flex items-center justify-center px-3 text-gray-500 transition hover:text-blue-800 focus:outline-none"
                                    aria-label="Afficher le mot de passe"
                                    aria-controls="password"
                                    aria-pressed="false"
                                >
                                    <span id="eye-open" class="inline-flex">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                            <path d="M10 3C5.455 3 1.73 6.11.458 10c1.272 3.89 4.997 7 9.542 7 4.544 0 8.27-3.11 9.542-7C18.27 6.11 14.544 3 10 3zm0 11a4 4 0 110-8 4 4 0 010 8z" />
                                            <path d="M10 8a2 2 0 100 4 2 2 0 000-4z" />
                                        </svg>
                                    </span>
                                    <span id="eye-closed" class="hidden">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M3 3l18 18" />
                                            <path d="M10.58 10.58a2 2 0 102.83 2.83" />
                                            <path d="M9.88 4.24A10.94 10.94 0 0112 4c5 0 9.27 3.11 11 8a11.83 11.83 0 01-4.24 5.4" />
                                            <path d="M6.61 6.61A11.84 11.84 0 001 12c1.73 4.89 6 8 11 8a10.94 10.94 0 005.39-1.39" />
                                        </svg>
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="pt-0.5">
                        <button
                            type="submit"
                            class="w-full bg-gradient-to-r from-blue-800 to-blue-900 hover:from-blue-900 hover:to-slate-900 text-white text-base font-semibold py-3 px-3 rounded-xl shadow-lg shadow-blue-900/30 hover:shadow-xl hover:shadow-blue-900/40 transition-all duration-200"
                        >
                            Se connecter
                        </button>
                    </div>
                </form>

                <p class="mt-5 text-center text-sm text-gray-600">
                    Pas encore de compte ?
                    <a href="{{ path('app_register') }}" class="font-semibold text-blue-800 hover:text-blue-900 hover:underline">S'inscrire</a>
                </p>
        </div>
    </div>
</div>
<script>
    function initLoginPasswordToggle() {
        const passwordInput = document.getElementById('password');
        const toggleButton = document.getElementById('toggle-password');
        const eyeOpen = document.getElementById('eye-open');
        const eyeClosed = document.getElementById('eye-closed');

        if (!passwordInput || !toggleButton || !eyeOpen || !eyeClosed) {
            return;
        }

        if (toggleButton.dataset.toggleBound === 'true') {
            return;
        }

        toggleButton.dataset.toggleBound = 'true';

        toggleButton.addEventListener('click', function () {
            const isHidden = passwordInput.type === 'password';
            passwordInput.type = isHidden ? 'text' : 'password';
            toggleButton.setAttribute('aria-pressed', String(isHidden));
            toggleButton.setAttribute('aria-label', isHidden ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
            eyeOpen.classList.toggle('hidden', isHidden);
            eyeClosed.classList.toggle('hidden', !isHidden);
        });
    }

    document.addEventListener('DOMContentLoaded', initLoginPasswordToggle);
    document.addEventListener('turbo:load', initLoginPasswordToggle);
</script>
{% include 'partials/footer.html.twig' %}
{% endblock %}
