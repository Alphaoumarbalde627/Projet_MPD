{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
{% include 'partials/headers.html.twig' %}
<style>
.registration-field:has(input:not(:placeholder-shown)) .field-icon { opacity: 0; pointer-events: none; }
.registration-field .field-icon { transition: opacity 0.2s ease; }
.registration-field input::placeholder { color: transparent; }
.registration-field input { transition: padding-left 0.2s ease; }
.registration-field:has(input:not(:placeholder-shown)) input { padding-left: 0.75rem; }

/* style pour message d'erreur téléphone */
.tel-errors ul li {
    color: #e3342f;          /* rouge vif */
    font-size: 0.75rem;      /* plus petit */
}
</style>
<div class="min-h-screen bg-gray-100 pt-16 pb-10 flex flex-col justify-center sm:pt-20 sm:pb-12">
    <div class="relative py-2 w-full max-w-xs mx-auto px-3">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-400 via-blue-500 to-indigo-600 shadow-2xl transform -skew-y-3 sm:skew-y-0 sm:-rotate-3 sm:rounded-3xl opacity-95"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-blue-300 to-indigo-500 shadow-xl transform skew-y-3 sm:skew-y-0 sm:rotate-3 sm:rounded-3xl opacity-80 -z-10"></div>
        <div class="relative px-4 py-6 bg-white/95 backdrop-blur shadow-2xl sm:rounded-3xl sm:p-6">
            <div class="mx-auto">
                <div class="text-center mb-4">
                    <h1 class="text-xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Créer un compte</h1>
                    <p class="mt-0.5 text-xs text-gray-500">Rejoignez Galerie MPD</p>
                </div>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-3 px-3 py-2 rounded-lg text-xs font-medium {{ label == 'success' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-800 border border-red-200' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {{ form_start(registrationForm, {'attr': {'class': 'space-y-3', 'data-turbo': 'false'}}) }}

                    {# Prénom #}
                    <div class="relative">
                        {{ form_label(registrationForm.prenom, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </span>
                            {{ form_widget(registrationForm.prenom, {'attr': {'class': 'w-full pl-9 pr-3 py-2 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(registrationForm.prenom) }}
                    </div>

                    {# Nom #}
                    <div class="relative">
                        {{ form_label(registrationForm.nom, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </span>
                            {{ form_widget(registrationForm.nom, {'attr': {'class': 'w-full pl-9 pr-3 py-2 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(registrationForm.nom) }}
                    </div>

                    {# Email #}
                    <div class="relative">
                        {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </span>
                            {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full pl-9 pr-3 py-2 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    {# Téléphone #}
                    <div class="relative">
                        {{ form_label(registrationForm.tel, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V21a2 2 0 01-2 2h-1C9.716 23 3 16.284 3 8V5z"/></svg>
                            </span>
                            {{ form_widget(registrationForm.tel, {'attr': {'class': 'w-full pl-9 pr-3 py-2 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        <div class="tel-errors text-red-600 text-xs mt-1">
                            {{ form_errors(registrationForm.tel) }}
                        </div>
                    </div>

                    {# Mot de passe #}
                    <div class="relative">
                        {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            </span>
                            {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'w-full pl-9 pr-3 py-2 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(registrationForm.plainPassword.first) }}
                    </div>

                    {# Confirmation mot de passe #}
                    <div class="relative">
                        {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'block text-xs font-medium text-gray-700 mb-1'}}) }}
                        <div class="registration-field relative flex items-center border-2 border-gray-200 rounded-lg focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20 transition">
                            <span class="field-icon absolute left-2.5 flex items-center justify-center text-gray-400 pointer-events-none">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            </span>
                            {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'w-full pl-9 pr-3 py-2 rounded-lg text-sm text-gray-900 focus:outline-none border-0', 'placeholder': ' '}}) }}
                        </div>
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>

                    <div class="pt-0.5">
                        {{ form_widget(registrationForm.submit, {
                            'attr': {'class': 'w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-sm font-semibold py-2.5 px-3 rounded-xl shadow-lg shadow-blue-500/30 hover:shadow-xl hover:shadow-blue-500/40 transition-all duration-200'}
                        }) }}
                    </div>
                {{ form_end(registrationForm) }}

                <p class="mt-4 text-center text-xs text-gray-600">
                    Déjà un compte ?
                    <a href="{{ path('app_login') }}" class="font-semibold text-blue-600 hover:text-blue-700 hover:underline">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% include 'partials/footer.html.twig' %}
{% endblock %}
