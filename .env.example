###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: mysql://USER:PASSWORD@127.0.0.1:3306/DB_NAME?serverVersion=8.0.32&charset=utf8mb4
DATABASE_URL="mysql://nom_user:password@127.0.0.1:3306/nom_base?serverVersion=nom_de_la_version(ex :10.8.32)&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Use doctrine transport table messenger_messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Local dev example
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/routing ###
DEFAULT_URI=http://127.0.0.1:8001 à changer en fonction de votre configuration
###< symfony/routing ###

###> symfony/debug-bundle ###
VAR_DUMPER_SERVER=tcp://127.0.0.1:9912
###< symfony/debug-bundle ###
